T3_CODE_URL=https://code.moondiner.com
T3_AUTH_URL=https://auth.moondiner.com
T3_RELAY_URL=https://relay.moondiner.com
T3_CONNECT_DOMAIN=connect.moondiner.com
T3_OBSERVABILITY_URL=https://observe.moondiner.com
T3_FRPS_PUBLIC_PORT=443
T3_APNS_ENABLED=false
T3_APNS_ENVIRONMENT=sandbox
T3_APNS_TEAM_ID=
T3_APNS_KEY_ID=
T3_APNS_BUNDLE_ID=
T3_APNS_PRIVATE_KEY_B64=
T3_APNS_DELIVERY_JOB_SIGNING_SECRET=
T3_ACCOUNT_ALLOWED_EMAILS=replace-with-your-login-email

# Shared only between telemetry producers and the authenticated ingest gateway.
# Generate distinct values with `openssl rand -hex 48` and never expose either
# token in a browser bundle or repository-managed environment file.
T3_OTLP_INGEST_TOKEN=replace-with-openssl-rand-hex-48
T3_LOKI_INGEST_TOKEN=replace-with-openssl-rand-hex-48
T3_LOKI_INGEST_BASIC_AUTH=replace-with-basic-base64-coolify-colon-loki-token
T3_GRAFANA_ADMIN_USER=admin
T3_GRAFANA_ADMIN_PASSWORD=replace-with-openssl-rand-hex-32
T3_GRAFANA_SECRET_KEY=replace-with-openssl-rand-hex-48
T3_ALERT_WEBHOOK_URL=
T3_PROMETHEUS_RETENTION=30d
T3_PROMETHEUS_RETENTION_SIZE=20GB

# Optional active environment probes and transition alerts. The monitor is a
# private service in the control Compose project and never publishes a port.
# List only managed hostnames that should always be online. The webhook must
# point to a receiver you control and must not carry secrets in its query.
T3_MONITOR_MANAGED_HOSTS=
T3_MONITOR_ALERT_WEBHOOK_URL=

# Use URL-safe values (hex is recommended) because these are embedded in
# PostgreSQL connection URLs inside the private Compose network.
T3_POSTGRES_ADMIN_PASSWORD=replace-with-openssl-rand-hex-32
T3_ACCOUNT_DB_PASSWORD=replace-with-openssl-rand-hex-32
T3_RELAY_DB_PASSWORD=replace-with-openssl-rand-hex-32
T3_ACCOUNT_SECRET=replace-with-at-least-32-random-characters

# Base64-encoded Ed25519 PKCS#8 private key and SPKI public key. Generate once
# and retain an offline backup; rotating this pair invalidates relay trust.
T3_RELAY_SIGNING_PRIVATE_KEY_B64=replace-with-base64-pkcs8-pem
T3_RELAY_SIGNING_PUBLIC_KEY_B64=replace-with-base64-spki-pem

# Optional deployment identity. A commit SHA is a good value in CI.
T3_IMAGE_TAG=latest

# Leave Compose profiles unset for the control-plane-only deployment. Add
# COMPOSE_PROFILES=frps only during the final public data-plane stage.
