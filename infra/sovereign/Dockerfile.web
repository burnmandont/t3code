FROM node:24.13.1-bookworm-slim AS build

ARG T3CODE_OAUTH_ISSUER
ARG T3CODE_OAUTH_CLIENT_ID=t3-code
ARG T3CODE_OAUTH_RESOURCE
ARG T3CODE_RELAY_URL
ARG VITE_HOSTED_APP_URL
ARG SOURCE_COMMIT

ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:$PATH
ENV T3CODE_OAUTH_ISSUER=$T3CODE_OAUTH_ISSUER
ENV T3CODE_OAUTH_CLIENT_ID=$T3CODE_OAUTH_CLIENT_ID
ENV T3CODE_OAUTH_RESOURCE=$T3CODE_OAUTH_RESOURCE
ENV T3CODE_RELAY_URL=$T3CODE_RELAY_URL
ENV VITE_HOSTED_APP_URL=$VITE_HOSTED_APP_URL
ENV VITE_HOSTED_APP_CHANNEL=sovereign
ENV VITE_REMOTE_FAVICONS=0
ENV T3CODE_WEB_SOURCEMAP=0

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global pnpm@11.10.0

WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts --filter @t3tools/web...
RUN pnpm rebuild esbuild
RUN test -n "$SOURCE_COMMIT" \
    && runtime_version="$(SOURCE_COMMIT="$SOURCE_COMMIT" node infra/sovereign/runtime/set-runtime-version.mjs --print-only)" \
    && SOVEREIGN_RUNTIME_VERSION="$runtime_version" node infra/sovereign/runtime/write-control-plane-discovery.mjs \
    && APP_VERSION="$runtime_version" pnpm --filter @t3tools/web build \
    && node scripts/apply-web-brand-assets.ts production apps/web/dist

FROM nginx:1.29.1-alpine

COPY infra/sovereign/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

EXPOSE 8080
