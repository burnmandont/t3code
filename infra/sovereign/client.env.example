# Public sovereign client configuration. Copy this file to the repository-root
# .env.local. None of these values are credentials or server-side secrets.
T3CODE_OAUTH_ISSUER=https://auth.moondiner.com/api/auth
T3CODE_OAUTH_CLIENT_ID=t3-code
T3CODE_OAUTH_RESOURCE=https://relay.moondiner.com
T3CODE_RELAY_URL=https://relay.moondiner.com
VITE_HOSTED_APP_URL=https://code.moondiner.com
VITE_HOSTED_APP_CHANNEL=sovereign
VITE_REMOTE_FAVICONS=0

# iOS signing identities are variant-specific so a production build cannot
# silently inherit the development App ID. Increment the build number for
# every App Store Connect upload.
T3CODE_APPLE_TEAM_ID=U2TDSUCYT4
T3CODE_IOS_BUNDLE_ID_DEVELOPMENT=com.moondiner.t3code.development
T3CODE_IOS_BUNDLE_ID_PRODUCTION=com.moondiner.t3code
T3CODE_IOS_BUILD_NUMBER=1

# Keep Clerk and OTLP/Axiom variables unset. The sovereign launch command
# fails closed if external identity or client-telemetry configuration is found.
